{
  "name": "vajra-styling-benchmark",
  "version": "0.0.0",
  "private": true,
  "description": "Isolated benchmark workspace comparing React Native styling systems against Vajra UI",
  "scripts": {
    "benchmark:visual": "jest --config jest.config.js --testMatch '<rootDir>/parity/*.parity.test.tsx'",
    "benchmark:run": "node scripts/run-benchmark.js",
    "benchmark:report": "node scripts/generate-report.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "device:start": "react-native start",
    "device:ios": "node scripts/run-device-benchmark.js --platform ios",
    "device:android": "node scripts/run-device-benchmark.js --platform android",
    "benchmark:smoke-card": "node scripts/generate-report-card.js --smoke",
    "benchmark:report-card": "node scripts/generate-report-card.js"
  },
  "dependencies": {
    "@88khp/vajra-ui": "file:./vendor/88khp-vajra-ui-3.0.0-alpha.1-7b3a116e.tgz",
    "@88khp/vajra-ui-core": "file:./vendor/88khp-vajra-ui-core-3.0.0-alpha.1-53bf2d2c.tgz",
    "@88khp/vajra-ui-core-prev": "npm:@88khp/vajra-ui-core@3.0.0-alpha.0",
    "@88khp/vajra-ui-prev": "npm:@88khp/vajra-ui@3.0.0-alpha.0",
    "@devraj-labs/vajra-ui-icons": "0.2.0",
    "css-to-react-native": "3.2.0",
    "lucide-react-native": "^1.28.0",
    "nativewind": "4.2.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.84.1",
    "react-native-css-interop": "0.2.7",
    "react-native-edge-to-edge": "1.8.2",
    "react-native-nitro-modules": "0.37.1",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "5.5.2",
    "react-native-svg": "^15.0.0",
    "react-native-unistyles": "3.5.3",
    "react-native-worklets": "0.10.4",
    "styled-components": "6.6.0",
    "tailwindcss": "3.4.19",
    "tamagui": "3.1.2",
    "twrnc": "4.16.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.84.1",
    "@react-native/metro-config": "0.84.1",
    "@react-native/normalize-colors": "0.84.1",
    "@tailwindcss/container-queries": "0.1.1",
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.0.0",
    "@types/react-test-renderer": "^19.1.0",
    "jest": "^29.6.3",
    "postcss": "8.5.31",
    "react-test-renderer": "19.2.3",
    "typescript": "^5.3.3"
  }
}
