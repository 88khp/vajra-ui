{
  "name": "@88khp/vajra-ui",
  "version": "3.0.0",
  "description": "A minimal zero dependency React Native styling and theming library",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "publishConfig": {
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "types": "./dist/index.d.ts"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && tsc --project tsconfig.build.json",
    "dev": "tsc --project tsconfig.build.json --watch",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "jest",
    "format": "prettier --write 'src/**/*.{ts,tsx}'",
    "prepare": "node -e \"process.exit(require('fs').existsSync('.git') ? 0 : 1)\" && husky || true",
    "release": "npm run build && npm publish --access public",
    "release:alpha": "npm run build && npm publish --access public --tag alpha"
  },
  "keywords": [
    "react-native",
    "ui",
    "design-system",
    "theming"
  ],
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "prettier --write",
      "prettier --check",
      "eslint --max-warnings=0"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/88khp/vajra-ui"
  },
  "homepage": "https://github.com/88khp/vajra-ui#readme",
  "license": "MIT",
  "peerDependencies": {
    "@88khp/vajra-core": "3.0.0",
    "@88khp/vajra-icons": ">=0.3.0",
    "react": ">=18.0.0",
    "react-native": ">=0.73.0",
    "react-native-safe-area-context": ">=4.8.0"
  },
  "peerDependenciesMeta": {
    "@88khp/vajra-icons": {
      "optional": true
    }
  },
  "devDependencies": {
    "@88khp/vajra-core": "3.0.0",
    "@88khp/vajra-icons": "0.3.0",
    "@react-native/babel-preset": "0.84.1",
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-check-file": "^3.3.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-native": "^4.1.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-sort-keys": "^2.3.5",
    "husky": "^9.1.7",
    "jest": "^29.6.3",
    "lint-staged": "^16.4.0",
    "lucide-react-native": "^1.28.0",
    "prettier": "^3.2.5",
    "react": "^19.2.4",
    "react-native": "^0.84.1",
    "react-native-safe-area-context": "4.8.0",
    "react-native-svg": "^15.0.0",
    "react-test-renderer": "19.2.8",
    "typescript": "^5.3.3"
  }
}
